{
  "name": "@local/jellyfish-theme",
  "version": "1.0.9",
  "private": true,
  "description": "Deep-Sea Jellyfish theme for the Deepseek Harness Web UI: bioluminescent abyss palette plus an illustration as the shell backdrop.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "cordis",
    "theme"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ailixiya24865-alt/dsh-jellyfish-theme.git"
  },
  "homepage": "https://github.com/ailixiya24865-alt/dsh-jellyfish-theme#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.jpg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.tpl.js",
    "tools",
    "assets/backdrop.jpg",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.jpg",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
